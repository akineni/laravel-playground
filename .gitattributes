* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

CHANGELOG.md export-ignore
README.md export-ignore
.github/workflows/browser-tests.yml export-ignore

# Frontend asset sources excluded from GitHub's language stats so the repo is
# reported as PHP (this is a Laravel application; the React/Inertia frontend
# is a supporting asset layer, not the project's primary language).
resources/js/** linguist-vendored
